{
        "schemaVersion": 1,
        "id": "${id}",
        "version": "${version}",
        "name": "${name}",
        "description": "Easily refresh villager trades with a single click! Adds a cycle button to villager trading screens that allows you to regenerate Level 1 trades before trading with them.",
        "authors": [
                "Partacus-SPQR"
        ],
        "contact": {
                "homepage": "https://github.com/Partacus-SPQR/VillagerCycle",
                "sources": "https://github.com/Partacus-SPQR/VillagerCycle"
        },
        "license": "MIT",
        "icon": "assets/villagercycle/icon.png",
        "environment": "*",
        "entrypoints": {
                "main": [
                        "com.villagercycle.VillagerCycleMod"
                ],
                "client": [
                        "com.villagercycle.client.VillagerCycleClient"
                ],
                "modmenu": [
                        "com.villagercycle.config.ModMenuIntegration"
                ]
        },
        "mixins": [
                "villagercycle.mixins.json",
                {
                        "config": "villagercycle.client.mixins.json",
                        "environment": "client"
                }
        ],
        "depends": {
                "fabricloader": ">=0.18.0",
                "minecraft": "${minecraft}",
                "java": ">=21",
                "fabric-api": "*"
        },
        "recommends": {
                "modmenu": "*",
                "cloth-config": "*"
        }
}
